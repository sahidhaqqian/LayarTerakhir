+                "DOC_PROLOG_01_SURAT_KOS", "SMARTPHONE_RAKA", "KUNCI_MOTOR", "POWERBANK_KECIL_KOS", "JAKET_RAKA" }));
+            yield return Interact(director.kosDoorItem, new Vector3(0.85f, 0.05f, -0.3f));
