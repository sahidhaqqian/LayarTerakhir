    },
    {
      "speaker": "Raka",
      "text": "Warung Bu Sari masih buka. Jalan ke Atmaja lewat ujung kompleks ini...",
      "path": "Assets/_LayarTerakhir/Audio/Dialogue/4e82803b5d64.wav",
      "duration": 6.4,
      "peak": 0.70684814453125,
      "rms": 0.1462135587673931,
      "sha256": "436ed86432641711b4103d1d92ad0f3d4810690ecc37453eb74415cc9aa54f09"
    },
    {
      "speaker": "Damar",
      "text": "Ka... Raka, jangan ke Rumah Atmaja sendirian. Tolong dengerin gue. Aplikasi kamera yang gue oprek dari darkweb kemarin... itu bukan filter AR biasa, Ka. Rumah ini nggak kosong. Di lantai dua ada suara perempuan nyanyi tembang Jawa, tapi pas gue sorot pakai kamera HP, dia udah berdiri tepat di depan muka gue—",
      "path": "Assets/_LayarTerakhir/Audio/Dialogue/00bc8f7547b9.wav",
      "duration": 23.2,
      "peak": 0.709259033203125,
      "rms": 0.1970661156122723,
      "sha256": "f3ce5736d9004776eb1e55ed396373c5b37e66432825e9378c491180ef24f8d7"
    },
    {
      "speaker": "Raka",
      "text": "Sial pintunya dikunci, aku harus cari jalan lain.",
      "path": "Assets/_LayarTerakhir/Audio/Dialogue/575ce4f38f7e.wav",
