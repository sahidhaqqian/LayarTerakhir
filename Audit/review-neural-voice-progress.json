    },
    {
      "speaker": "Raka",
      "text": "Apa...?! Lepas!",
      "path": "Assets/_LayarTerakhir/Audio/Dialogue/49e8883812d9.wav",
      "duration": 5.28,
      "peak": 0.70770263671875,
      "rms": 0.12786789249197983,
