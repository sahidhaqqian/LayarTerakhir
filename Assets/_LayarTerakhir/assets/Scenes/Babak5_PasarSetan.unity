--- !u!114 &1471700881
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1471700880}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a6e68cd675aafed0bf76a0cee3eb72c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LayarTerakhir.Phase5.Phase5Director
  endingShots:
  - ending: 1
    from: {fileID: 266667529}
    to: {fileID: 526490331}
    look: {fileID: 1189147093}
    speaker: Damar
    subtitle: 'Ka... lo beneran milih itu? [Tangan pucat menarik Damar ke balik lantai
      cermin.]'
    seconds: 8
    epilogueSet: -1
  - ending: 1
    from: {fileID: 1457445845}
    to: {fileID: 2030908198}
    look: {fileID: 1120101242}
    speaker: SATU BULAN KEMUDIAN
    subtitle: 'Operasi Ibu lunas. Rp500.000.000 tertera di dashboard. Di studio,
      Raka menulis dengan akun baru: Penonton_Terakhir.'
    seconds: 11
    epilogueSet: 0
  - ending: 1
    from: {fileID: 1906058838}
    to: {fileID: 1038238668}
    look: {fileID: 2094589354}
    speaker: Penonton_Terakhir
    subtitle: '[Di cermin studio, Damar berdiri di belakang sang tuan rumah baru.]
      Siaran berikutnya akan segera dimulai.'
    seconds: 9
    epilogueSet: 0
  - ending: 2
    from: {fileID: 475391801}
    to: {fileID: 1110556787}
    look: {fileID: 892246716}
    speaker: Raka
    subtitle: Gue udah janji bakal bawa lo pulang, Dam. Maafin gue kalau gue nggak
      bisa ikut.
    seconds: 9
    epilogueSet: -1
  - ending: 2
    from: {fileID: 919258344}
    to: {fileID: 1280462090}
    look: {fileID: 608855113}
    speaker: Siaran Terputus
    subtitle: '[HP Raka pecah. Jaringan siaran padam; Damar didorong melewati cermin
      sebelum Pasar Setan runtuh.]'
    seconds: 8
    epilogueSet: -1
  - ending: 2
    from: {fileID: 1411051451}
    to: {fileID: 1215709847}
    look: {fileID: 727217430}
    speaker: Damar
    subtitle: 'Satu juta penonton sadar. Raka Wijaya masih dinyatakan hilang. [Di
      kaca HP yang mati, pantulan Raka melambaikan tangan.]'
    seconds: 11
    epilogueSet: 1
  - ending: 3
    from: {fileID: 19800529}
    to: {fileID: 660038903}
    look: {fileID: 1836173208}
    speaker: Raka
    subtitle: Kalian mau tontonan terakhir?! INI LAYAR TERAKHIR BUAT LO!
    seconds: 7
    epilogueSet: -1
  - ending: 3
    from: {fileID: 1880836329}
    to: {fileID: 1244503619}
    look: {fileID: 733755934}
    speaker: Jepretan Terakhir
    subtitle: '[Blitz memantul di antara cermin. Jaringan Penonton_Terakhir terbakar;
      Raka dan Damar terlempar ke arah subuh.]'
    seconds: 8
    epilogueSet: -1
  - ending: 3
    from: {fileID: 79902363}
    to: {fileID: 387293997}
    look: {fileID: 968558954}
    speaker: Damar
    subtitle: Ka... mulai besok, kita ganti channel aja ya. Bikin konten kuliner
      atau mukbang kek... jangan uji nyali lagi.
    seconds: 9
    epilogueSet: 1
  - ending: 3
    from: {fileID: 435602628}
    to: {fileID: 416379543}
    look: {fileID: 2091533648}
    speaker: Raka
    subtitle: 'Setuju. Malam Keramat resmi tamat malam ini. [05:30 WIB. MataBatin.apk
      terhapus. Donasi tulus tersisa Rp125.000.000.]'
    seconds: 10
    epilogueSet: 1
  - ending: 4
    from: {fileID: 607165368}
    to: {fileID: 1119384541}
    look: {fileID: 1206157164}
    speaker: Raka
    subtitle: Mereka bukan angka penonton. Mereka punya nama.
    seconds: 7
    epilogueSet: -1
  - ending: 4
    from: {fileID: 1367418983}
    to: {fileID: 974884515}
    look: {fileID: 783642007}
    speaker: Damar
    subtitle: Rekam kesaksiannya, Ka. Biar kali ini mereka yang pulang.
    seconds: 7
    epilogueSet: -1
  - ending: 4
    from: {fileID: 197375508}
    to: {fileID: 1421338840}
    look: {fileID: 1776266431}
    speaker: Arsip Saksi
    subtitle: Tari. Lastri dan anaknya. Sembilan anak buruh. Warga Karang Setra.
      Kesaksian bebas membatalkan klaim kontrak; korban lama meninggalkan jaringan
      ritual.
    seconds: 12
    epilogueSet: 2
  - ending: 4
    from: {fileID: 1679305077}
    to: {fileID: 1872103358}
    look: {fileID: 45612127}
    speaker: Saksi Tanpa Layar
    subtitle: Raka dan Damar menyerahkan catatan korban kepada keluarga. Donasi sah
      Rp125.000.000. MataBatin.apk tak kembali. Kursi kosong; cermin biasa, tanpa
      wajah yang tertinggal.
    seconds: 12
    epilogueSet: 2
  credits: {fileID: 4900000, guid: 466123fc61af955d29d1d862840b5040, type: 3}
