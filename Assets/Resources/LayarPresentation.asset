%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 971419719008922eca8b0492f1604d8e, type: 3}
  m_Name: LayarPresentation
  m_EditorClassIdentifier: Assembly-CSharp::LayarTerakhir.Core.PresentationProfile
  bodyFont: {fileID: 12800000, guid: 0a753425ecbca20a987f1ec2d689fb11, type: 3}
  phoneFeedMaterial: {fileID: 2100000, guid: 8b08d15e604db8547bc2795fcc4aef09, type: 2}
  audio: {fileID: 11400000, guid: 88c1da6064516fc40850805345f28e0d, type: 2}
  voices:
  - speaker: Raka
    text: Tiga puluh dua penonton... Itu pun paling setengahnya akun bot. Kalau malam
      ini nggak ada konten yang meledak, tamat riwayat gue di Jakarta.
    clip: {fileID: 8300000, guid: 0c5bbe55251246511b32190a007d0287, type: 3}
  - speaker: Raka
    text: Tiga setengah juta besok pagi... Gue cari ke mana jam segini?!
    clip: {fileID: 8300000, guid: 97f4d81de71a4c56f8836848ae9d6aee, type: 3}
  - speaker: Raka
    text: Dam?! Halo, Damar?! Sial, nomornya nggak aktif!
    clip: {fileID: 8300000, guid: 2a49eec4de91f9021977e779b881f83f, type: 3}
  - speaker: Raka
    text: Gue cek dulu apa yang diselipin di bawah pintu tadi.
    clip: {fileID: 8300000, guid: 497b90beed83d721cb2a9c68c1f42c58, type: 3}
  - speaker: Raka
    text: Kebuka. Powerbank, dompet, sama buku harian gue masih di sini.
    clip: {fileID: 8300000, guid: b7ea53967dbfe15ec97e46d9176cd537, type: 3}
  - speaker: Raka
    text: Bentar, gue belum mau keluar sebelum cek bawah pintu.
    clip: {fileID: 8300000, guid: 72df1d32b4a8198d7ad0483142a19a48, type: 3}
  - speaker: Raka
    text: Jaket udah dipakai. Hujan di luar makin deres.
    clip: {fileID: 8300000, guid: 91e154a0fc5e541fca12c9a3bb36cfdb, type: 3}
  - speaker: Raka
    text: Gue belum siap berangkat.
    clip: {fileID: 8300000, guid: be020d926eae86f8bae1d844be94a0a6, type: 3}
  - speaker: Bisikan
    text: Haus... bukakan...
    clip: {fileID: 8300000, guid: 014c39716574bb5c68ce7cff99153b44, type: 3}
  - speaker: Raka
    text: Itu motornya Damar... Mesinnya udah dingin, berarti dia udah di dalem sejak
      jam sembilan tadi.
    clip: {fileID: 8300000, guid: 86373617a552f63d3b6c90b6ba2181e8, type: 3}
  - speaker: Raka
    text: Anjir! Anginnya kenceng banget... Eh bentar, ini jendelanya kok nyangkut?!
    clip: {fileID: 8300000, guid: bc71b6f9472fed142a8269a90b16924c, type: 3}
  - speaker: Raka
    text: Ini HP-nya Damar... Layarnya pecah, tapi kartu memorinya masih kebaca.
      Gue pindahin dulu aplikasinya ke HP gue.
    clip: {fileID: 8300000, guid: 63854c79fc304e2f2956a696a8d3322a, type: 3}
  - speaker: Raka
    text: Jejak tangan... berdarah semua. Ya Tuhan...
    clip: {fileID: 8300000, guid: 95ce49f22a4b31b10a5b58cc01f030bb, type: 3}
  - speaker: Raka
    text: Airnya... merah kecokelatan. Kayak karat... atau darah.
    clip: {fileID: 8300000, guid: d0acd73346edd45b89756845799ae57f, type: 3}
  - speaker: Raka
    text: Karpetnya digulung... ada pintu jebakan kayu di bawahnya.
    clip: {fileID: 8300000, guid: 4f2e24717b757db1d9f0f4fa6d0f1e19, type: 3}
  - speaker: Raka
    text: Tangga batu... turun ke bawah tanah. Dingin banget hawanya.
    clip: {fileID: 8300000, guid: c74e207adf935cf6681ccbca3cee0729, type: 3}
  - speaker: Raka
    text: 80 persen... Oke, masih bisa lanjut.
    clip: {fileID: 8300000, guid: 9d787b8fd08f77432861f3fe57f35fdd, type: 3}
  - speaker: Raka
    text: Sial, ada gangguan daya! Gue harus cari powerbank cadangan di tas peralatan
      Damar atau HP ini mati total!
    clip: {fileID: 8300000, guid: 7898c4f4eac19e48abbaace8c9c2c93d, type: 3}
  - speaker: Damar (rekaman)
    text: "Kacanya... kacanya bukan mantulin ruangan ini, Ka! Di dalem kaca itu ada
      pasar malam... mereka narik kaki gue\u2014RAKA TOLONGIN GUE!"
    clip: {fileID: 8300000, guid: c55f4b192326f703786bd97e2ed84697, type: 3}
  - speaker: Nyonya Sri Atmaja
    text: AAAAAARGH!!!
    clip: {fileID: 8300000, guid: 5f9d1e225860da467af435e281ab04b3, type: 3}
  - speaker: Raka
    text: '*terengah-engah* ...Gue... selamat... Damar... gue bakal balik buat lo...'
    clip: {fileID: 8300000, guid: d52e83997e6d40213ab5a950232c0e17, type: 3}
  - speaker: Damar
    text: Raka! Tolong! Aaaah!
    clip: {fileID: 8300000, guid: 2c2de3795775c1e6aa25392e465ccf80, type: 3}
  - speaker: Raka
    text: Anjir, Damar dalam bahaya! Duit ini nggak gratis... Untuk sementara gue
      harus ikutin perintah dari pesan ini.
    clip: {fileID: 8300000, guid: 0cedc67bc1cabb42793bf91721e95764, type: 3}
  - speaker: Raka
    text: Hmm... kok tiba-tiba ketutup, ya? Kayaknya kita cuma bisa lanjut.
    clip: {fileID: 8300000, guid: e31868448e6b91f63af3121b41d8c910, type: 3}
  - speaker: Raka
    text: Oke... tes, satu dua. Malam semuanya, balik lagi di Malam Keramat. Malam
      ini gue nggak sendirian... maksudnya, gue lagi nyusulin Damar yang hilang kontak
      di Rumah Tua Atmaja. Buat yang baru gabung, bantu pantau layar ya.
    clip: {fileID: 8300000, guid: 338ca84ed04656e4cad0e7b62e7cdb52, type: 3}
  - speaker: Raka
    text: Damar! Damar!
    clip: {fileID: 8300000, guid: fdd2c8cb60c0b276e977fec9405980ab, type: 3}
  - speaker: "Damar \u2022 dari lantai atas"
    text: AAARGH! Raka...!
    clip: {fileID: 8300000, guid: 2659131cb65c17e32a5be7193a56f172, type: 3}
  - speaker: Raka
    text: Dam?! Suaranya dari atas...
    clip: {fileID: 8300000, guid: 04e4e63e8d73106f0975c1d4b7dccb05, type: 3}
  - speaker: Raka
    text: Siapa... yang duduk di situ?
    clip: {fileID: 8300000, guid: 7ae78ca6804b22adb8bd79eb70389726, type: 3}
  - speaker: Raka
    text: Apa...?! Lepas!
    clip: {fileID: 8300000, guid: fe0faf0f6407beff9a2c61912e535363, type: 3}
  - speaker: Raka
    text: Warung Bu Sari masih buka. Jalan ke Atmaja lewat ujung kompleks ini...
    clip: {fileID: 8300000, guid: 346cf61186de2a5bfb07c0a193cc9058, type: 3}
  - speaker: Damar
    text: "Ka... Raka, jangan ke Rumah Atmaja sendirian. Tolong dengerin gue. Aplikasi
      kamera yang gue oprek dari darkweb kemarin... itu bukan filter AR biasa, Ka.
      Rumah ini nggak kosong. Di lantai dua ada suara perempuan nyanyi tembang Jawa,
      tapi pas gue sorot pakai kamera HP, dia udah berdiri tepat di depan muka gue\u2014"
    clip: {fileID: 8300000, guid: 24b2725133d4ce35e87f5fc33a8d428d, type: 3}
  - speaker: Raka
    text: Sial pintunya dikunci, aku harus cari jalan lain.
    clip: {fileID: 8300000, guid: ed58574f6bbc1c5c7891f1657223008a, type: 3}
